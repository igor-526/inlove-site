# Stand domain (documentation only; never a runtime fallback): inlove-stand.eqcms.ru
# Required absolute public backend API URL; browser requests are sent directly (no Next.js proxy).
NEXT_PUBLIC_API_BASE_URL=
# Required public build-time tenant selector sent as X-Equestrian-Service-Key; no fallback.
NEXT_PUBLIC_EQUESTRIAN_SERVICE_KEY=
SENTRY_ENABLED=false
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0
SENTRY_RELEASE=
